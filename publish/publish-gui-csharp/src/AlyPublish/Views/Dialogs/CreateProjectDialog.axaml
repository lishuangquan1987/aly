<Window
    x:Class="AlyPublish.Views.Dialogs.CreateProjectDialog"
    x:DataType="vm:CreateProjectDialogViewModel"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:AlyPublish.Localization"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:AlyPublish.ViewModels"
    Title="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_WindowTitle}}"
    Width="560"
    Height="640"
    MinWidth="480"
    MinHeight="520"
    CanResize="True"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource SemiColorBg0}">

  <Grid Margin="24,20" RowDefinitions="Auto,*,Auto,Auto">
    <StackPanel Spacing="2">
      <TextBlock
          FontSize="15"
          FontWeight="SemiBold"
          Text="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_Heading}}" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Classes="caption" Text="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_ServerPrefix}}" />
        <TextBlock Classes="caption" Text="{Binding ServerUrl}" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer
        Grid.Row="1"
        Margin="0,14,0,0"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <StackPanel>
          <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_TitleLabel}}" />
          <TextBox PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_TitlePlaceholder}}" Text="{Binding ProjectTitle}" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_NameLabel}}" />
          <TextBox PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_NamePlaceholder}}" Text="{Binding ProjectName}" />
          <TextBlock
              Classes="caption"
              Margin="0,4,0,0"
              Text="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_NameHint}}" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_UpdatePolicyLabel}}" />
          <CheckBox
              Content="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_ForceUpdate}}"
              FontSize="12"
              Foreground="{DynamicResource SemiColorWarning}"
              IsChecked="{Binding ForceUpdate}" />
          <TextBlock
              Classes="caption"
              Text="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_ForceUpdateHint}}"
              TextWrapping="Wrap" />
        </StackPanel>

        <Expander Header="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_Rules_ExpanderHeader}}" HorizontalAlignment="Stretch">
          <StackPanel Margin="0,8,0,0" Spacing="12">
            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_Rules_IgnoreFolders}}" />
              <ItemsControl ItemsSource="{Binding IgnoreFolderSuggestions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button
                        Classes="Tertiary"
                        Command="{Binding #Root.((vm:CreateProjectDialogViewModel)DataContext).AddSuggestedIgnoreFolderCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding}"
                        FontSize="10"
                        Height="22"
                        Margin="0,0,6,4"
                        Padding="8,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <u:TagInput
                  AllowDuplicates="False"
                  PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_Rules_IgnoreFoldersPlaceholder}}"
                  Separator=","
                  Tags="{Binding IgnoreFolders}" />
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_Rules_IgnoreFiles}}" />
              <ItemsControl ItemsSource="{Binding IgnoreFileSuggestions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button
                        Classes="Tertiary"
                        Command="{Binding #Root.((vm:CreateProjectDialogViewModel)DataContext).AddSuggestedIgnoreFileCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding}"
                        FontSize="10"
                        Height="22"
                        Margin="0,0,6,4"
                        Padding="8,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <u:TagInput
                  AllowDuplicates="False"
                  PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_Rules_IgnoreFilesPlaceholder}}"
                  Separator=","
                  Tags="{Binding IgnoreFiles}" />
            </StackPanel>
          </StackPanel>
        </Expander>

        <TextBlock
            FontSize="11"
            Foreground="{DynamicResource SemiColorWarning}"
            IsVisible="{Binding HasValidationMessage}"
            Text="{Binding ValidationMessage}"
            TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <ProgressBar
        Grid.Row="2"
        Height="2"
        IsIndeterminate="True"
        IsVisible="{Binding IsBusy}"
        Margin="0,8,0,0" />

    <Grid ColumnDefinitions="*,Auto,Auto" Grid.Row="3" Margin="0,16,0,0">
      <TextBlock
          Classes="caption"
          Text="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_SuccessHint}}"
          TextWrapping="Wrap"
          VerticalAlignment="Center" />
      <Button
          Grid.Column="1"
          Command="{Binding CancelCommand}"
          Content="{Translate {x:Static loc:LanguageManager+Keys.Common_Cancel}}"
          Height="32"
          Margin="0,0,8,0"
          Padding="16,0" />
      <Button
          Grid.Column="2"
          Classes="Primary"
          Command="{Binding CreateCommand}"
          Content="{Translate {x:Static loc:LanguageManager+Keys.CreateProjectDialog_CreateButton}}"
          Height="32"
          Padding="20,0" />
    </Grid>
  </Grid>
</Window>