<Window
    x:Class="AlyPublish.Views.Dialogs.EditProjectDialog"
    x:DataType="vm:EditProjectDialogViewModel"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:AlyPublish.Localization"
    xmlns:constants="using:AlyPublish.Constants"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:AlyPublish.ViewModels"
    Title="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_WindowTitle}}"
    Width="660"
    Height="820"
    MinWidth="580"
    MinHeight="680"
    CanResize="True"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource SemiColorBg0}">

  <Grid Margin="24,20" RowDefinitions="Auto,Auto,*,Auto,Auto">
    <StackPanel Spacing="2">
      <TextBlock
          FontSize="15"
          FontWeight="SemiBold"
          Text="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Heading}}" />
      <TextBlock
          Classes="caption"
          Text="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Hint}}" />
    </StackPanel>

    <Border
        Background="{DynamicResource SemiColorFill0}"
        BorderBrush="{DynamicResource SemiColorDanger}"
        BorderThickness="1"
        CornerRadius="6"
        Grid.Row="1"
        IsVisible="{Binding HasLoadError}"
        Margin="0,10,0,0"
        Padding="10,8">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <materialIcons:MaterialIcon
            Foreground="{DynamicResource SemiColorDanger}"
            Height="14"
            Kind="AlertCircleOutline"
            VerticalAlignment="Center"
            Width="14" />
        <TextBlock
            FontSize="12"
            Foreground="{DynamicResource SemiColorDanger}"
            Text="{Binding LoadError}"
            TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ScrollViewer
        Grid.Row="2"
        Margin="0,12,0,0"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
      <StackPanel IsEnabled="{Binding IsLoaded}" Spacing="14">

        <Border Classes="card" Padding="14,12">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon
                  Foreground="{DynamicResource SemiColorText1}"
                  Height="14"
                  Kind="Monitor"
                  Width="14" />
              <TextBlock Classes="sectionTitle" Text="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_LocalDisplay_Label}}" />
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_DisplayName_Label}}" />
              <TextBox PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_DisplayName_Placeholder}}" Text="{Binding DisplayName}" />
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_MainExe_Label}}" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox
                    PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_MainExe_Placeholder}}"
                    Text="{Binding MainExePath}" />
                <Button
                    Grid.Column="1"
                    Click="OnBrowseMainExe"
                    Content="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_BrowseMainExe}}"
                    Height="32"
                    Margin="8,0,0,0"
                    Padding="12,0" />
              </Grid>
              <TextBlock
                  Classes="caption"
                  Margin="0,4,0,0"
                  Text="{Binding MainExeHint}"
                  TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="14,12">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon
                  Foreground="{DynamicResource SemiColorText1}"
                  Height="14"
                  Kind="Cog"
                  Width="14" />
              <TextBlock Classes="sectionTitle" Text="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Config_SectionTitle}}" />
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Config_ServerUrlLabel}}" />
              <TextBox PlaceholderText="http://localhost:2000" Text="{Binding ServerUrl}" />
              <ItemsControl ItemsSource="{Binding KnownServerUrls}" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button
                        Classes="Tertiary"
                        Command="{Binding #Root.((vm:EditProjectDialogViewModel)DataContext).UseKnownServerUrlCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding}"
                        FontSize="10"
                        Height="22"
                        Margin="0,0,6,4"
                        Padding="8,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Config_ProjectNameLabel}}" />
              <TextBox PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Config_ProjectNamePlaceholder}}" Text="{Binding ProjectName}" />
              <TextBlock
                  Classes="caption"
                  Margin="0,4,0,0"
                  Text="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Config_ProjectNameHint}}"
                  TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Rules_IgnoreFolders}}" />
              <ItemsControl ItemsSource="{x:Static constants:AppConstants.IgnoreFolderSuggestions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button
                        Classes="Tertiary"
                        Command="{Binding #Root.((vm:EditProjectDialogViewModel)DataContext).AddSuggestedIgnoreFolderCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding}"
                        FontSize="10"
                        Height="22"
                        Margin="0,0,6,4"
                        Padding="8,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto">
                <u:TagInput
                    AllowDuplicates="False"
                    PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Rules_IgnoreFoldersPlaceholder}}"
                    Separator=","
                    Tags="{Binding IgnoreFolders}" />
                <Button
                    Grid.Column="1"
                    Click="OnPickIgnoreFolder"
                    Height="32"
                    Margin="8,0,0,0"
                    Padding="0"
                    ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Rules_PickIgnoreFolderTooltip}}"
                    Width="32">
                  <materialIcons:MaterialIcon Height="14" Kind="Plus" Width="14" />
                </Button>
              </Grid>
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Rules_IgnoreFiles}}" />
              <ItemsControl ItemsSource="{x:Static constants:AppConstants.IgnoreFileSuggestions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button
                        Classes="Tertiary"
                        Command="{Binding #Root.((vm:EditProjectDialogViewModel)DataContext).AddSuggestedIgnoreFileCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding}"
                        FontSize="10"
                        Height="22"
                        Margin="0,0,6,4"
                        Padding="8,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto">
                <u:TagInput
                    AllowDuplicates="False"
                    PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Rules_IgnoreFilesPlaceholder}}"
                    Separator=","
                    Tags="{Binding IgnoreFiles}" />
                <Button
                    Grid.Column="1"
                    Click="OnPickIgnoreFile"
                    Height="32"
                    Margin="8,0,0,0"
                    Padding="0"
                    ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Rules_PickIgnoreFileTooltip}}"
                    Width="32">
                  <materialIcons:MaterialIcon Height="14" Kind="Plus" Width="14" />
                </Button>
              </Grid>
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Rules_UnCopyFolders}}" />
              <Grid ColumnDefinitions="*,Auto">
                <u:TagInput
                    AllowDuplicates="False"
                    PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Rules_UnCopyFoldersPlaceholder}}"
                    Separator=","
                    Tags="{Binding UnCopyFolders}" />
                <Button
                    Grid.Column="1"
                    Click="OnPickUnCopyFolder"
                    Height="32"
                    Margin="8,0,0,0"
                    Padding="0"
                    ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Rules_PickUnCopyFolderTooltip}}"
                    Width="32">
                  <materialIcons:MaterialIcon Height="14" Kind="Plus" Width="14" />
                </Button>
              </Grid>
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Rules_UnCopyFiles}}" />
              <Grid ColumnDefinitions="*,Auto">
                <u:TagInput
                    AllowDuplicates="False"
                    PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Rules_UnCopyFilesPlaceholder}}"
                    Separator=","
                    Tags="{Binding UnCopyFiles}" />
                <Button
                    Grid.Column="1"
                    Click="OnPickUnCopyFile"
                    Height="32"
                    Margin="8,0,0,0"
                    Padding="0"
                    ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_Rules_PickUnCopyFileTooltip}}"
                    Width="32">
                  <materialIcons:MaterialIcon Height="14" Kind="Plus" Width="14" />
                </Button>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <ProgressBar
        Grid.Row="3"
        Height="2"
        IsIndeterminate="True"
        IsVisible="{Binding IsBusy}"
        Margin="0,8,0,0" />

    <Grid ColumnDefinitions="*,Auto,Auto" Grid.Row="4" Margin="0,16,0,0">
      <TextBlock
          FontSize="11"
          Foreground="{DynamicResource SemiColorWarning}"
          IsVisible="{Binding HasValidationMessage}"
          Text="{Binding ValidationMessage}"
          TextWrapping="Wrap"
          VerticalAlignment="Center" />
      <Button
          Grid.Column="1"
          Command="{Binding CancelCommand}"
          Content="{Translate {x:Static loc:LanguageManager+Keys.Common_Cancel}}"
          Height="32"
          Margin="0,0,8,0"
          Padding="16,0" />
      <Button
          Grid.Column="2"
          Classes="Primary"
          Command="{Binding SaveCommand}"
          Content="{Translate {x:Static loc:LanguageManager+Keys.EditProjectDialog_SaveButton}}"
          Height="32"
          Padding="20,0" />
    </Grid>
  </Grid>
</Window>