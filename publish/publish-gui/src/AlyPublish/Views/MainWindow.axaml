<Window
    x:Class="AlyPublish.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:constants="using:AlyPublish.Constants"
    xmlns:local="using:AlyPublish.Models.Local"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:views="using:AlyPublish.Views"
    xmlns:vm="using:AlyPublish.ViewModels"
    Title="{x:Static constants:AppConstants.AppTitle}"
    Width="1320"
    Height="840"
    MinWidth="1080"
    MinHeight="640"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource SemiColorBg0}">

  <Window.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding RefreshCurrentCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding PublishCurrentCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding EditProjectCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!--  Toolbar  -->
    <Border
        Background="{DynamicResource SemiColorBg1}"
        BorderBrush="{DynamicResource SemiColorBorder}"
        BorderThickness="0,0,0,1"
        Grid.Row="0">
      <Grid ColumnDefinitions="*,Auto" Margin="12,8">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button
              Classes="Primary"
              Command="{Binding AddProjectCommand}"
              Height="30"
              Padding="12,0"
              ToolTip.Tip="选择一个未初始化的目录并生成 .updator 配置">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Height="16" Kind="PlusCircleOutline" Width="16" />
              <TextBlock FontSize="13" Text="初始化项目" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button
              Command="{Binding AddLocalProjectCommand}"
              Height="30"
              Padding="12,0"
              ToolTip.Tip="添加已经包含 .updator/shared.json 的目录">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Height="16" Kind="FolderOpenOutline" Width="16" />
              <TextBlock FontSize="13" Text="添加本地项目" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Separator
              Background="{DynamicResource SemiColorBorder}"
              Height="18"
              Margin="6,0"
              Width="1" />
          <Button
              Command="{Binding EditProjectCommand}"
              Height="30"
              Padding="10,0"
              ToolTip.Tip="项目设置 (Ctrl+E)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Height="14" Kind="CogOutline" Width="14" />
              <TextBlock FontSize="12" Text="项目设置" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button
              Classes="Danger"
              Command="{Binding RemoveProjectCommand}"
              Height="30"
              Padding="10,0"
              ToolTip.Tip="从列表移除项目（不会删除项目文件）">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon Height="14" Kind="DeleteOutline" Width="14" />
              <TextBlock FontSize="12" Text="移除" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">
          <Border
              Classes="pill"
              IsVisible="{Binding IsCliAvailable}"
              ToolTip.Tip="{Binding CliHint}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse
                  Fill="{DynamicResource SemiColorSuccess}"
                  Height="7"
                  Width="7" />
              <TextBlock
                  FontSize="11"
                  Foreground="{DynamicResource SemiColorText2}"
                  Text="CLI 就绪" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!--  CLI missing banner  -->
    <Border
        Background="{DynamicResource SemiColorFill0}"
        BorderBrush="{DynamicResource SemiColorWarning}"
        BorderThickness="0,0,0,1"
        Grid.Row="1"
        IsVisible="{Binding !IsCliAvailable}"
        Padding="14,8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <materialIcons:MaterialIcon
            Foreground="{DynamicResource SemiColorWarning}"
            Height="16"
            Kind="AlertCircleOutline"
            VerticalAlignment="Center"
            Width="16" />
        <StackPanel Grid.Column="1" Margin="8,0,12,0" Spacing="2">
          <TextBlock
              FontSize="13"
              FontWeight="SemiBold"
              Foreground="{DynamicResource SemiColorWarning}"
              Text="未找到 aly-publish.exe" />
          <TextBlock
              Classes="caption"
              Text="{Binding CliHint}"
              TextWrapping="Wrap" />
        </StackPanel>
        <Button
            Grid.Column="2"
            Command="{Binding RetryCliCommand}"
            Content="重新检测"
            Height="28"
            Padding="10,0" />
        <Button
            Grid.Column="3"
            Command="{Binding OpenCliFolderCommand}"
            Content="打开程序目录"
            Height="28"
            Margin="8,0,0,0"
            Padding="10,0" />
      </Grid>
    </Border>

    <!--  Master-detail body  -->
    <Grid ColumnDefinitions="240,*" Grid.Row="2">

      <!--  Left: project list  -->
      <Border
          Background="{DynamicResource SemiColorBg1}"
          BorderBrush="{DynamicResource SemiColorBorder}"
          BorderThickness="0,0,1,0"
          Grid.Column="0">
        <Grid RowDefinitions="Auto,*">
          <Border
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="0,0,0,1"
              Padding="14,10">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <materialIcons:MaterialIcon
                    Foreground="{DynamicResource SemiColorText2}"
                    Height="14"
                    Kind="FolderOutline"
                    VerticalAlignment="Center"
                    Width="14" />
                <TextBlock
                    Classes="sectionTitle"
                    VerticalAlignment="Center">
                  <Run Text="项目 " />
                  <Run Foreground="{DynamicResource SemiColorText3}" Text="{Binding Projects.Count}" />
                </TextBlock>
              </StackPanel>
              <TextBox
                  FontSize="12"
                  Height="28"
                  PlaceholderText="搜索名称或路径"
                  Text="{Binding ProjectFilter, Mode=TwoWay}" />
            </StackPanel>
          </Border>

          <ListBox
              x:Name="ProjectList"
              Grid.Row="1"
              Classes="nav"
              ItemsSource="{Binding FilteredProjects}"
              SelectedItem="{Binding SelectedProject}"
              IsVisible="{Binding HasFilteredProjects}"
              Margin="4,4">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:ProjectConfig">
                <Border Padding="10,8" ToolTip.Tip="{Binding ProjectPath}">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="navName" Text="{Binding DisplayName}" />
                    <TextBlock
                        Classes="navPath"
                        Text="{Binding ProjectPath}"
                        TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel
              Grid.Row="1"
              HorizontalAlignment="Center"
              IsVisible="{Binding HasNoFilterMatches}"
              Spacing="10"
              VerticalAlignment="Center">
            <materialIcons:MaterialIcon
                Foreground="{DynamicResource SemiColorText3}"
                Height="28"
                Kind="Magnify"
                HorizontalAlignment="Center"
                Width="28" />
            <TextBlock Classes="emptyTitle" Text="没有匹配的项目" />
            <Button
                Command="{Binding ClearProjectFilterCommand}"
                Content="清除搜索"
                Height="28"
                Padding="12,0" />
          </StackPanel>

          <StackPanel
              Grid.Row="1"
              HorizontalAlignment="Center"
              IsVisible="{Binding !HasProjects}"
              Spacing="10"
              VerticalAlignment="Center">
            <materialIcons:MaterialIcon
                Foreground="{DynamicResource SemiColorText3}"
                Height="32"
                Kind="FolderPlusOutline"
                HorizontalAlignment="Center"
                Width="32" />
            <TextBlock Classes="emptyTitle" Text="还没有项目" />
            <TextBlock
                Classes="emptyHint"
                MaxWidth="180"
                Text="初始化一个新的发布项目，或添加已经配置好的目录。" />
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
              <Button
                  Classes="Primary"
                  Command="{Binding AddProjectCommand}"
                  Content="初始化项目"
                  Height="30"
                  Padding="12,0" />
              <Button
                  Command="{Binding AddLocalProjectCommand}"
                  Content="添加本地项目"
                  Height="30"
                  Padding="12,0" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!--  Right: project detail  -->
      <Grid Grid.Column="1">
        <Grid IsVisible="{Binding HasSelectedTab}">
          <views:ProjectTabView DataContext="{Binding SelectedTab}" />
        </Grid>

        <StackPanel
            HorizontalAlignment="Center"
            IsVisible="{Binding !HasSelectedTab}"
            Spacing="10"
            VerticalAlignment="Center">
          <materialIcons:MaterialIcon
              Foreground="{DynamicResource SemiColorText3}"
              Height="36"
              Kind="FolderOpenOutline"
              HorizontalAlignment="Center"
              Width="36" />
          <TextBlock Classes="emptyTitle" Text="从左侧选择一个项目" />
          <TextBlock
              Classes="emptyHint"
              MaxWidth="340"
              Text="项目详情、文件变更、发布面板和版本历史都会显示在这里。" />
        </StackPanel>
      </Grid>
    </Grid>

    <!--  Status bar  -->
    <Border
        Background="{DynamicResource SemiColorBg1}"
        BorderBrush="{DynamicResource SemiColorBorder}"
        BorderThickness="0,1,0,0"
        Grid.Row="3"
        Padding="14,0">
      <Grid ColumnDefinitions="*,Auto" Height="28">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <materialIcons:MaterialIcon
              Foreground="{DynamicResource SemiColorText3}"
              Height="12"
              Kind="InformationOutline"
              Width="12" />
          <TextBlock
              FontSize="11"
              Foreground="{DynamicResource SemiColorText2}"
              Text="{Binding SelectedTab.StatusMessage, FallbackValue='未选择项目'}"
              TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            Margin="12,0,0,0"
            Orientation="Horizontal"
            Spacing="6"
            VerticalAlignment="Center">
          <SelectableTextBlock
              FontSize="10"
              Foreground="{DynamicResource SemiColorText3}"
              MaxWidth="360"
              Text="{Binding SelectedTab.Project.ProjectPath}"
              TextTrimming="CharacterEllipsis"
              ToolTip.Tip="{Binding SelectedTab.Project.ProjectPath}" />
          <Button
              Classes="Tertiary"
              Command="{Binding OpenLogFolderCommand}"
              Height="22"
              Padding="6,0"
              ToolTip.Tip="打开日志目录">
            <TextBlock FontSize="10" Text="日志" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>

  <Window.Styles>
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
    </Style>
    <Style Selector="ListBox.nav TextBlock.navName">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
    </Style>
    <Style Selector="ListBox.nav TextBlock.navPath">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText3}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>
</Window>