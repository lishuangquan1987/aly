<Window
    x:Class="AlyPublish.Views.Dialogs.AddLocalProjectDialog"
    x:DataType="vm:AddLocalProjectDialogViewModel"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:AlyPublish.Localization"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:vm="using:AlyPublish.ViewModels"
    Title="{Translate {x:Static loc:LanguageManager+Keys.S004}}"
    Width="580"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource SemiColorBg0}">

  <StackPanel Margin="24,20" Spacing="14">
    <StackPanel Spacing="2">
      <TextBlock
          FontSize="15"
          FontWeight="SemiBold"
          Text="{Translate {x:Static loc:LanguageManager+Keys.S068}}" />
      <TextBlock
          Classes="caption"
          Text="{Translate {x:Static loc:LanguageManager+Keys.S069}}" />
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.S070}}" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox
            PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.S071}}"
            Text="{Binding ProjectPath}" />
        <Button
            Grid.Column="1"
            Click="OnBrowseProjectFolder"
            Content="{Translate {x:Static loc:LanguageManager+Keys.S072}}"
            Height="32"
            Margin="8,0,0,0"
            Padding="12,0" />
      </Grid>
      <Border
          Background="{DynamicResource SemiColorFill0}"
          CornerRadius="6"
          Margin="0,6,0,0"
          Padding="10,8">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <materialIcons:MaterialIcon
              Foreground="{DynamicResource SemiColorText3}"
              Height="14"
              Kind="FolderOpenOutline"
              VerticalAlignment="Center"
              Width="14" />
          <TextBlock Classes="caption" Text="{Translate {x:Static loc:LanguageManager+Keys.S073}}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </StackPanel>

    <Border
        Background="{DynamicResource SemiColorFill0}"
        BorderBrush="{DynamicResource SemiColorBorder}"
        BorderThickness="1"
        CornerRadius="6"
        Padding="10,8">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <materialIcons:MaterialIcon
            Foreground="{DynamicResource SemiColorText2}"
            Height="14"
            Kind="InformationOutline"
            VerticalAlignment="Center"
            Width="14" />
        <TextBlock
            FontSize="12"
            Foreground="{DynamicResource SemiColorText1}"
            Text="{Binding InitStatusMessage}"
            TextWrapping="Wrap"
            VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border
        Classes="card"
        IsVisible="{Binding HasPreview}"
        Padding="12,10">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
        <TextBlock Classes="fieldLabel" Text="{Translate {x:Static loc:LanguageManager+Keys.S038}}" />
        <TextBlock
            Grid.Column="1"
            FontSize="12"
            Text="{Binding PreviewServerUrl}"
            TextTrimming="CharacterEllipsis" />
        <TextBlock
            Classes="fieldLabel"
            Grid.Row="1"
            Text="{Translate {x:Static loc:LanguageManager+Keys.S074}}" />
        <TextBlock
            Grid.Column="1"
            Grid.Row="1"
            FontSize="12"
            Text="{Binding PreviewProjectName}" />
        <TextBlock
            Classes="fieldLabel"
            Grid.Row="2"
            Text="{Translate {x:Static loc:LanguageManager+Keys.S075}}" />
        <TextBlock
            Grid.Column="1"
            Grid.Row="2"
            FontSize="12">
          <Run Text="{Binding PreviewIgnoreCount}" />
          <Run Text="{Translate {x:Static loc:LanguageManager+Keys.S076}}" />
        </TextBlock>
      </Grid>
    </Border>

    <StackPanel>
      <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.S077}}" />
      <TextBox PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.S078}}" Text="{Binding DisplayName}" />
    </StackPanel>

    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
      <TextBlock
          Classes="caption"
          Text="{Translate {x:Static loc:LanguageManager+Keys.S079}}"
          VerticalAlignment="Center" />
      <Button
          Grid.Column="1"
          Command="{Binding CancelCommand}"
          Content="{Translate {x:Static loc:LanguageManager+Keys.S058}}"
          Height="32"
          Margin="0,0,8,0"
          Padding="16,0" />
      <Button
          Grid.Column="2"
          Classes="Primary"
          Command="{Binding ConfirmCommand}"
          Content="{Translate {x:Static loc:LanguageManager+Keys.S080}}"
          Height="32"
          Padding="20,0" />
    </Grid>
  </StackPanel>
</Window>