<Window
    x:Class="AlyPublish.Views.Dialogs.AddLocalProjectDialog"
    x:DataType="vm:AddLocalProjectDialogViewModel"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:vm="using:AlyPublish.ViewModels"
    Title="添加本地项目"
    Width="580"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource SemiColorBg0}">

  <StackPanel Margin="24,20" Spacing="14">
    <StackPanel Spacing="2">
      <TextBlock
          FontSize="15"
          FontWeight="SemiBold"
          Text="添加已初始化的项目" />
      <TextBlock
          Classes="caption"
          Text="目录中必须已经包含 .updator/shared.json；服务端地址和项目名会自动读取。" />
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="项目文件夹" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox
            PlaceholderText="选择项目文件夹，或直接拖到窗口"
            Text="{Binding ProjectPath}" />
        <Button
            Grid.Column="1"
            Click="OnBrowseProjectFolder"
            Content="浏览…"
            Height="32"
            Margin="8,0,0,0"
            Padding="12,0" />
      </Grid>
      <Border
          Background="{DynamicResource SemiColorFill0}"
          CornerRadius="6"
          Margin="0,6,0,0"
          Padding="10,8">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <materialIcons:MaterialIcon
              Foreground="{DynamicResource SemiColorText3}"
              Height="14"
              Kind="FolderOpenOutline"
              VerticalAlignment="Center"
              Width="14" />
          <TextBlock Classes="caption" Text="支持拖拽文件夹到本窗口。" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </StackPanel>

    <Border
        Background="{DynamicResource SemiColorFill0}"
        BorderBrush="{DynamicResource SemiColorBorder}"
        BorderThickness="1"
        CornerRadius="6"
        Padding="10,8">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <materialIcons:MaterialIcon
            Foreground="{DynamicResource SemiColorText2}"
            Height="14"
            Kind="InformationOutline"
            VerticalAlignment="Center"
            Width="14" />
        <TextBlock
            FontSize="12"
            Foreground="{DynamicResource SemiColorText1}"
            Text="{Binding InitStatusMessage}"
            TextWrapping="Wrap"
            VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border
        Classes="card"
        IsVisible="{Binding HasPreview}"
        Padding="12,10">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
        <TextBlock Classes="fieldLabel" Text="服务端" />
        <TextBlock
            Grid.Column="1"
            FontSize="12"
            Text="{Binding PreviewServerUrl}"
            TextTrimming="CharacterEllipsis" />
        <TextBlock
            Classes="fieldLabel"
            Grid.Row="1"
            Text="项目" />
        <TextBlock
            Grid.Column="1"
            Grid.Row="1"
            FontSize="12"
            Text="{Binding PreviewProjectName}" />
        <TextBlock
            Classes="fieldLabel"
            Grid.Row="2"
            Text="忽略规则" />
        <TextBlock
            Grid.Column="1"
            Grid.Row="2"
            FontSize="12">
          <Run Text="{Binding PreviewIgnoreCount}" />
          <Run Text=" 项" />
        </TextBlock>
      </Grid>
    </Border>

    <StackPanel>
      <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="显示名称（左侧列表中的别名）" />
      <TextBox PlaceholderText="默认使用项目名或文件夹名" Text="{Binding DisplayName}" />
    </StackPanel>

    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
      <TextBlock
          Classes="caption"
          Text="添加后不会复制项目文件，只保存书签。"
          VerticalAlignment="Center" />
      <Button
          Grid.Column="1"
          Command="{Binding CancelCommand}"
          Content="取消"
          Height="32"
          Margin="0,0,8,0"
          Padding="16,0" />
      <Button
          Grid.Column="2"
          Classes="Primary"
          Command="{Binding ConfirmCommand}"
          Content="添加项目"
          Height="32"
          Padding="20,0" />
    </Grid>
  </StackPanel>
</Window>