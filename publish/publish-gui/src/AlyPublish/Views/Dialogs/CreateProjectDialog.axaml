<Window
    x:Class="AlyPublish.Views.Dialogs.CreateProjectDialog"
    x:DataType="vm:CreateProjectDialogViewModel"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:AlyPublish.ViewModels"
    Title="在服务端新建项目"
    Width="560"
    Height="640"
    MinWidth="480"
    MinHeight="520"
    CanResize="True"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource SemiColorBg0}">

  <Grid Margin="24,20" RowDefinitions="Auto,*,Auto,Auto">
    <StackPanel Spacing="2">
      <TextBlock
          FontSize="15"
          FontWeight="SemiBold"
          Text="新建服务端项目" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Classes="caption" Text="服务端：" />
        <TextBlock Classes="caption" Text="{Binding ServerUrl}" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer
        Grid.Row="1"
        Margin="0,14,0,0"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <StackPanel>
          <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="项目标题（展示给最终用户）" />
          <TextBox PlaceholderText="例如 我的应用" Text="{Binding ProjectTitle}" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="项目名称（唯一标识，默认跟随标题）" />
          <TextBox PlaceholderText="例如 myapp" Text="{Binding ProjectName}" />
          <TextBlock
              Classes="caption"
              Margin="0,4,0,0"
              Text="一旦修改名称，后续修改标题不会再自动同步名称。请确保服务端不存在同名项目。" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="更新策略" />
          <CheckBox
              Content="强制更新（客户端不再询问，直接更新）"
              FontSize="12"
              Foreground="{DynamicResource SemiColorWarning}"
              IsChecked="{Binding ForceUpdate}" />
          <TextBlock
              Classes="caption"
              Text="仅在客户端必须跳过用户确认时启用；普通发布保持关闭。"
              TextWrapping="Wrap" />
        </StackPanel>

        <Expander Header="忽略规则（可稍后在项目设置中修改）" HorizontalAlignment="Stretch">
          <StackPanel Margin="0,8,0,0" Spacing="12">
            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="忽略文件夹" />
              <ItemsControl ItemsSource="{Binding IgnoreFolderSuggestions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button
                        Classes="Tertiary"
                        Command="{Binding #Root.((vm:CreateProjectDialogViewModel)DataContext).AddSuggestedIgnoreFolderCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding}"
                        FontSize="10"
                        Height="22"
                        Margin="0,0,6,4"
                        Padding="8,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <u:TagInput
                  AllowDuplicates="False"
                  PlaceholderText="输入后回车添加"
                  Separator=","
                  Tags="{Binding IgnoreFolders}" />
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="忽略文件" />
              <ItemsControl ItemsSource="{Binding IgnoreFileSuggestions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button
                        Classes="Tertiary"
                        Command="{Binding #Root.((vm:CreateProjectDialogViewModel)DataContext).AddSuggestedIgnoreFileCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding}"
                        FontSize="10"
                        Height="22"
                        Margin="0,0,6,4"
                        Padding="8,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <u:TagInput
                  AllowDuplicates="False"
                  PlaceholderText="输入后回车添加"
                  Separator=","
                  Tags="{Binding IgnoreFiles}" />
            </StackPanel>
          </StackPanel>
        </Expander>

        <TextBlock
            FontSize="11"
            Foreground="{DynamicResource SemiColorWarning}"
            IsVisible="{Binding HasValidationMessage}"
            Text="{Binding ValidationMessage}"
            TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <ProgressBar
        Grid.Row="2"
        Height="2"
        IsIndeterminate="True"
        IsVisible="{Binding IsBusy}"
        Margin="0,8,0,0" />

    <Grid ColumnDefinitions="*,Auto,Auto" Grid.Row="3" Margin="0,16,0,0">
      <TextBlock
          Classes="caption"
          Text="创建成功后会自动回到项目选择步骤并选中它。"
          TextWrapping="Wrap"
          VerticalAlignment="Center" />
      <Button
          Grid.Column="1"
          Command="{Binding CancelCommand}"
          Content="取消"
          Height="32"
          Margin="0,0,8,0"
          Padding="16,0" />
      <Button
          Grid.Column="2"
          Classes="Primary"
          Command="{Binding CreateCommand}"
          Content="创建项目"
          Height="32"
          Padding="20,0" />
    </Grid>
  </Grid>
</Window>