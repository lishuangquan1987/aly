<Window
    x:Class="AlyPublish.Views.Dialogs.EditProjectDialog"
    x:DataType="vm:EditProjectDialogViewModel"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:constants="using:AlyPublish.Constants"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:AlyPublish.ViewModels"
    Title="项目设置"
    Width="660"
    Height="820"
    MinWidth="580"
    MinHeight="680"
    CanResize="True"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource SemiColorBg0}">

  <Grid Margin="24,20" RowDefinitions="Auto,Auto,*,Auto,Auto">
    <StackPanel Spacing="2">
      <TextBlock
          FontSize="15"
          FontWeight="SemiBold"
          Text="项目设置" />
      <TextBlock
          Classes="caption"
          Text="修改会写入 .updator/shared.json，并在保存时同步服务端忽略规则。" />
    </StackPanel>

    <Border
        Background="{DynamicResource SemiColorFill0}"
        BorderBrush="{DynamicResource SemiColorDanger}"
        BorderThickness="1"
        CornerRadius="6"
        Grid.Row="1"
        IsVisible="{Binding HasLoadError}"
        Margin="0,10,0,0"
        Padding="10,8">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <materialIcons:MaterialIcon
            Foreground="{DynamicResource SemiColorDanger}"
            Height="14"
            Kind="AlertCircleOutline"
            VerticalAlignment="Center"
            Width="14" />
        <TextBlock
            FontSize="12"
            Foreground="{DynamicResource SemiColorDanger}"
            Text="{Binding LoadError}"
            TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ScrollViewer
        Grid.Row="2"
        Margin="0,12,0,0"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
      <StackPanel IsEnabled="{Binding IsLoaded}" Spacing="14">

        <Border Classes="card" Padding="14,12">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon
                  Foreground="{DynamicResource SemiColorText1}"
                  Height="14"
                  Kind="Monitor"
                  Width="14" />
              <TextBlock Classes="sectionTitle" Text="本机显示" />
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="显示名称" />
              <TextBox PlaceholderText="左侧列表中的别名" Text="{Binding DisplayName}" />
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="主程序（用于“启动”按钮与 UpdateFolder）" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox
                    PlaceholderText="选择主程序 exe（可选）"
                    Text="{Binding MainExePath}" />
                <Button
                    Grid.Column="1"
                    Click="OnBrowseMainExe"
                    Content="浏览…"
                    Height="32"
                    Margin="8,0,0,0"
                    Padding="12,0" />
              </Grid>
              <TextBlock
                  Classes="caption"
                  Margin="0,4,0,0"
                  Text="{Binding MainExeHint}"
                  TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="14,12">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon
                  Foreground="{DynamicResource SemiColorText1}"
                  Height="14"
                  Kind="Cog"
                  Width="14" />
              <TextBlock Classes="sectionTitle" Text="项目配置 (.updator/)" />
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="服务端地址" />
              <TextBox PlaceholderText="http://localhost:2000" Text="{Binding ServerUrl}" />
              <ItemsControl ItemsSource="{Binding KnownServerUrls}" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button
                        Classes="Tertiary"
                        Command="{Binding #Root.((vm:EditProjectDialogViewModel)DataContext).UseKnownServerUrlCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding}"
                        FontSize="10"
                        Height="22"
                        Margin="0,0,6,4"
                        Padding="8,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="服务端项目名称" />
              <TextBox PlaceholderText="例如 myapp" Text="{Binding ProjectName}" />
              <TextBlock
                  Classes="caption"
                  Margin="0,4,0,0"
                  Text="修改后客户端会按新名称连接服务端；请确保服务端已存在同名项目。"
                  TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="忽略文件夹" />
              <ItemsControl ItemsSource="{x:Static constants:AppConstants.IgnoreFolderSuggestions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button
                        Classes="Tertiary"
                        Command="{Binding #Root.((vm:EditProjectDialogViewModel)DataContext).AddSuggestedIgnoreFolderCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding}"
                        FontSize="10"
                        Height="22"
                        Margin="0,0,6,4"
                        Padding="8,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto">
                <u:TagInput
                    AllowDuplicates="False"
                    PlaceholderText="输入后回车添加"
                    Separator=","
                    Tags="{Binding IgnoreFolders}" />
                <Button
                    Grid.Column="1"
                    Click="OnPickIgnoreFolder"
                    Height="32"
                    Margin="8,0,0,0"
                    Padding="0"
                    ToolTip.Tip="从项目目录选择文件夹"
                    Width="32">
                  <materialIcons:MaterialIcon Height="14" Kind="Plus" Width="14" />
                </Button>
              </Grid>
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="忽略文件" />
              <ItemsControl ItemsSource="{x:Static constants:AppConstants.IgnoreFileSuggestions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button
                        Classes="Tertiary"
                        Command="{Binding #Root.((vm:EditProjectDialogViewModel)DataContext).AddSuggestedIgnoreFileCommand}"
                        CommandParameter="{Binding}"
                        Content="{Binding}"
                        FontSize="10"
                        Height="22"
                        Margin="0,0,6,4"
                        Padding="8,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto">
                <u:TagInput
                    AllowDuplicates="False"
                    PlaceholderText="输入后回车添加"
                    Separator=","
                    Tags="{Binding IgnoreFiles}" />
                <Button
                    Grid.Column="1"
                    Click="OnPickIgnoreFile"
                    Height="32"
                    Margin="8,0,0,0"
                    Padding="0"
                    ToolTip.Tip="从项目目录选择文件"
                    Width="32">
                  <materialIcons:MaterialIcon Height="14" Kind="Plus" Width="14" />
                </Button>
              </Grid>
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="不复制文件夹（应用更新时跳过）" />
              <Grid ColumnDefinitions="*,Auto">
                <u:TagInput
                    AllowDuplicates="False"
                    PlaceholderText="输入后回车添加"
                    Separator=","
                    Tags="{Binding UnCopyFolders}" />
                <Button
                    Grid.Column="1"
                    Click="OnPickUnCopyFolder"
                    Height="32"
                    Margin="8,0,0,0"
                    Padding="0"
                    ToolTip.Tip="从项目目录选择文件夹"
                    Width="32">
                  <materialIcons:MaterialIcon Height="14" Kind="Plus" Width="14" />
                </Button>
              </Grid>
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="不复制文件（应用更新时跳过）" />
              <Grid ColumnDefinitions="*,Auto">
                <u:TagInput
                    AllowDuplicates="False"
                    PlaceholderText="输入后回车添加"
                    Separator=","
                    Tags="{Binding UnCopyFiles}" />
                <Button
                    Grid.Column="1"
                    Click="OnPickUnCopyFile"
                    Height="32"
                    Margin="8,0,0,0"
                    Padding="0"
                    ToolTip.Tip="从项目目录选择文件"
                    Width="32">
                  <materialIcons:MaterialIcon Height="14" Kind="Plus" Width="14" />
                </Button>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <ProgressBar
        Grid.Row="3"
        Height="2"
        IsIndeterminate="True"
        IsVisible="{Binding IsBusy}"
        Margin="0,8,0,0" />

    <Grid ColumnDefinitions="*,Auto,Auto" Grid.Row="4" Margin="0,16,0,0">
      <TextBlock
          FontSize="11"
          Foreground="{DynamicResource SemiColorWarning}"
          IsVisible="{Binding HasValidationMessage}"
          Text="{Binding ValidationMessage}"
          TextWrapping="Wrap"
          VerticalAlignment="Center" />
      <Button
          Grid.Column="1"
          Command="{Binding CancelCommand}"
          Content="取消"
          Height="32"
          Margin="0,0,8,0"
          Padding="16,0" />
      <Button
          Grid.Column="2"
          Classes="Primary"
          Command="{Binding SaveCommand}"
          Content="保存"
          Height="32"
          Padding="20,0" />
    </Grid>
  </Grid>
</Window>