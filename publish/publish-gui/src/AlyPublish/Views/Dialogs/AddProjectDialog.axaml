<Window
    x:Class="AlyPublish.Views.Dialogs.AddProjectDialog"
    x:DataType="vm:AddProjectDialogViewModel"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:AlyPublish.Localization"
    xmlns:cli="using:AlyPublish.Models.Cli"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:AlyPublish.ViewModels"
    Title="{Translate {x:Static loc:LanguageManager+Keys.S002}}"
    Width="680"
    Height="780"
    MinWidth="600"
    MinHeight="640"
    CanResize="True"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource SemiColorBg0}">

  <Grid Margin="24,20" RowDefinitions="Auto,*,Auto,Auto">

    <!--  Steps  -->
    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" Margin="0,0,0,16">
      <Border Classes="step" Classes.active="{Binding IsServerStep}">
        <TextBlock Text="1" />
      </Border>
      <TextBlock
          Grid.Column="1"
          FontSize="13"
          Foreground="{DynamicResource SemiColorText1}"
          Margin="8,0,0,0"
          Text="{Translate {x:Static loc:LanguageManager+Keys.S081}}"
          VerticalAlignment="Center" />
      <Border
          Background="{DynamicResource SemiColorBorder}"
          Grid.Column="2"
          Height="1"
          Margin="12,0"
          VerticalAlignment="Center"
          Width="28" />
      <Border Classes="step" Classes.active="{Binding IsLocalStep}" Grid.Column="3">
        <TextBlock Text="2" />
      </Border>
      <TextBlock
          Grid.Column="4"
          FontSize="13"
          Foreground="{DynamicResource SemiColorText1}"
          Margin="8,0,0,0"
          Text="{Translate {x:Static loc:LanguageManager+Keys.S082}}"
          VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="1">
      <!--  Step 1: server project  -->
      <ScrollViewer
          HorizontalScrollBarVisibility="Disabled"
          IsVisible="{Binding IsServerStep}"
          VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
          <StackPanel>
            <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.S083}}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox
                  PlaceholderText="http://localhost:2000"
                  Text="{Binding ServerUrl}" />
              <Button
                  Grid.Column="1"
                  Classes="Primary"
                  Command="{Binding FetchProjectsCommand}"
                  Content="{Translate {x:Static loc:LanguageManager+Keys.S084}}"
                  Height="32"
                  Margin="8,0,0,0"
                  Padding="12,0" />
            </Grid>
            <ItemsControl ItemsSource="{Binding KnownServerUrls}" Margin="0,6,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Button
                      Classes="Tertiary"
                      Command="{Binding #Root.((vm:AddProjectDialogViewModel)DataContext).UseServerUrlCommand}"
                      CommandParameter="{Binding}"
                      Content="{Binding}"
                      FontSize="10"
                      Height="22"
                      Margin="0,0,6,4"
                      Padding="8,0" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource SemiColorText2}"
                IsVisible="{Binding IsFetching}"
                Margin="0,6,0,0"
                Text="{Translate {x:Static loc:LanguageManager+Keys.S085}}" />
          </StackPanel>

          <Border
              Background="{DynamicResource SemiColorFill0}"
              BorderBrush="{DynamicResource SemiColorWarning}"
              BorderThickness="1"
              CornerRadius="6"
              IsVisible="{Binding HasFetchError}"
              Padding="10,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <materialIcons:MaterialIcon
                  Foreground="{DynamicResource SemiColorWarning}"
                  Height="14"
                  Kind="AlertCircleOutline"
                  VerticalAlignment="Center"
                  Width="14" />
              <TextBlock
                  FontSize="12"
                  Foreground="{DynamicResource SemiColorWarning}"
                  Text="{Binding FetchError}"
                  TextWrapping="Wrap"
                  VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <StackPanel Spacing="8" IsVisible="{Binding HasServerProjects}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox
                  PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.S086}}"
                  Text="{Binding FilterText}" />
              <TextBlock
                  Grid.Column="1"
                  Classes="caption"
                  Margin="10,0,0,0"
                  Text="{Translate {x:Static loc:LanguageManager+Keys.S087}}"
                  VerticalAlignment="Center" />
            </Grid>

            <ListBox
                Background="Transparent"
                ItemsSource="{Binding ServerProjects}"
                MaxHeight="260"
                SelectedItem="{Binding SelectedServerProject}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="cli:ProjectInfo">
                  <Border Padding="10,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock
                              FontSize="13"
                              FontWeight="SemiBold"
                              Text="{Binding Name}" />
                          <TextBlock
                              FontSize="11"
                              Foreground="{DynamicResource SemiColorText2}"
                              Text="{Binding Title}" />
                        </StackPanel>
                        <TextBlock Classes="caption">
                          <Run Text="ID " />
                          <Run Text="{Binding Id}" />
                        </TextBlock>
                      </StackPanel>
                      <StackPanel
                          Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="6"
                          VerticalAlignment="Center">
                        <Border Classes="pill">
                          <TextBlock
                              FontSize="10"
                              Text="{Binding Version, FallbackValue=' '}" />
                        </Border>
                        <Border
                            Background="{DynamicResource SemiColorWarning}"
                            CornerRadius="3"
                            IsVisible="{Binding IsForceUpdate}"
                            Padding="6,2">
                          <TextBlock
                              FontSize="10"
                              Foreground="White"
                              Text="{Translate {x:Static loc:LanguageManager+Keys.S088}}" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <Border
              Background="{DynamicResource SemiColorFill0}"
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="1"
              CornerRadius="6"
              IsVisible="{Binding ShowServerEmptyState}"
              Padding="20,18">
            <StackPanel HorizontalAlignment="Center" Spacing="6">
              <materialIcons:MaterialIcon
                  Foreground="{DynamicResource SemiColorText3}"
                  Height="26"
                  HorizontalAlignment="Center"
                  Kind="Server"
                  Width="26" />
              <TextBlock Classes="emptyTitle" Text="{Translate {x:Static loc:LanguageManager+Keys.S089}}" />
              <TextBlock
                  Classes="emptyHint"
                  MaxWidth="360"
                  Text="{Translate {x:Static loc:LanguageManager+Keys.S090}}" />
            </StackPanel>
          </Border>

          <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="8">
            <Button
                Command="{Binding CreateServerProjectCommand}"
                Content="{Translate {x:Static loc:LanguageManager+Keys.S091}}"
                Height="30"
                Padding="12,0" />
            <TextBlock
                Classes="caption"
                Text="{Translate {x:Static loc:LanguageManager+Keys.S092}}"
                VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!--  Step 2: local folder and executable  -->
      <ScrollViewer
          HorizontalScrollBarVisibility="Disabled"
          IsVisible="{Binding IsLocalStep}"
          VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <Border Classes="card" Padding="12,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <materialIcons:MaterialIcon
                  Foreground="{DynamicResource SemiColorPrimary}"
                  Height="16"
                  Kind="Server"
                  VerticalAlignment="Center"
                  Width="16" />
              <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="2">
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding SelectedServerProject.Name}" />
                <TextBlock
                    Classes="caption"
                    Text="{Binding SelectedServerProject.Title}" />
              </StackPanel>
              <Border
                  Classes="pill"
                  Grid.Column="2"
                  VerticalAlignment="Center">
                <TextBlock FontSize="10" Text="{Binding SelectedProjectVersionText}" />
              </Border>
            </Grid>
          </Border>

          <StackPanel>
            <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.S093}}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox
                  PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.S094}}"
                  Text="{Binding ProjectPath}" />
              <Button
                  Grid.Column="1"
                  Click="OnBrowseProjectFolder"
                  Content="{Translate {x:Static loc:LanguageManager+Keys.S072}}"
                  Height="32"
                  Margin="8,0,0,0"
                  Padding="12,0" />
            </Grid>
            <Border
                Background="{DynamicResource SemiColorFill0}"
                CornerRadius="6"
                Margin="0,6,0,0"
                Padding="10,8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <materialIcons:MaterialIcon
                    Foreground="{DynamicResource SemiColorText3}"
                    Height="14"
                    Kind="FolderOpenOutline"
                    VerticalAlignment="Center"
                    Width="14" />
                <TextBlock
                    Classes="caption"
                    Text="{Translate {x:Static loc:LanguageManager+Keys.S095}}"
                    VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource SemiColorText2}"
                Margin="0,6,0,0"
                Text="{Binding PathState}" />
          </StackPanel>

          <StackPanel>
            <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.S077}}" />
            <TextBox PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.S096}}" Text="{Binding DisplayName}" />
          </StackPanel>

          <StackPanel>
            <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.S097}}" />
            <ComboBox
                PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.S098}}"
                ItemsSource="{Binding MainExeCandidates}"
                SelectedItem="{Binding SelectedMainExeCandidate}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox
                  PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.S099}}"
                  Text="{Binding MainExePath}" />
              <Button
                  Grid.Column="1"
                  Click="OnBrowseMainExe"
                  Content="{Translate {x:Static loc:LanguageManager+Keys.S072}}"
                  Height="32"
                  Margin="8,0,0,0"
                  Padding="12,0" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0">
              <TextBlock
                  Classes="fieldLabel"
                  Text="{Translate {x:Static loc:LanguageManager+Keys.S100}}"
                  VerticalAlignment="Center" />
              <TextBox
                  Grid.Column="1"
                  Margin="10,0,0,0"
                  PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.S101}}"
                  Text="{Binding CloseProcessName}" />
            </Grid>
          </StackPanel>

          <Expander Header="{Translate {x:Static loc:LanguageManager+Keys.S102}}" HorizontalAlignment="Stretch">
            <StackPanel Margin="0,8,0,0" Spacing="12">
              <StackPanel>
                <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.S103}}" />
                <ItemsControl ItemsSource="{Binding IgnoreFolderSuggestions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Button
                          Classes="Tertiary"
                          Command="{Binding #Root.((vm:AddProjectDialogViewModel)DataContext).AddSuggestedIgnoreFolderCommand}"
                          CommandParameter="{Binding}"
                          Content="{Binding}"
                          FontSize="10"
                          Height="22"
                          Margin="0,0,6,4"
                          Padding="8,0" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto">
                  <u:TagInput
                      AllowDuplicates="False"
                      PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.S104}}"
                      Separator=","
                      Tags="{Binding IgnoreFolders}" />
                  <Button
                      Grid.Column="1"
                      Click="OnPickIgnoreFolder"
                      Height="32"
                      Margin="8,0,0,0"
                      Padding="0"
                      ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.S105}}"
                      Width="32">
                    <materialIcons:MaterialIcon Height="14" Kind="Plus" Width="14" />
                  </Button>
                </Grid>
              </StackPanel>

              <StackPanel>
                <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.S106}}" />
                <ItemsControl ItemsSource="{Binding IgnoreFileSuggestions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Button
                          Classes="Tertiary"
                          Command="{Binding #Root.((vm:AddProjectDialogViewModel)DataContext).AddSuggestedIgnoreFileCommand}"
                          CommandParameter="{Binding}"
                          Content="{Binding}"
                          FontSize="10"
                          Height="22"
                          Margin="0,0,6,4"
                          Padding="8,0" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto">
                  <u:TagInput
                      AllowDuplicates="False"
                      PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.S107}}"
                      Separator=","
                      Tags="{Binding IgnoreFiles}" />
                  <Button
                      Grid.Column="1"
                      Click="OnPickIgnoreFile"
                      Height="32"
                      Margin="8,0,0,0"
                      Padding="0"
                      ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.S108}}"
                      Width="32">
                    <materialIcons:MaterialIcon Height="14" Kind="Plus" Width="14" />
                  </Button>
                </Grid>
              </StackPanel>

              <StackPanel>
                <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.S109}}" />
                <Grid ColumnDefinitions="*,Auto">
                  <u:TagInput
                      AllowDuplicates="False"
                      PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.S110}}"
                      Separator=","
                      Tags="{Binding UnCopyFolders}" />
                  <Button
                      Grid.Column="1"
                      Click="OnPickUnCopyFolder"
                      Height="32"
                      Margin="8,0,0,0"
                      Padding="0"
                      ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.S105}}"
                      Width="32">
                    <materialIcons:MaterialIcon Height="14" Kind="Plus" Width="14" />
                  </Button>
                </Grid>
              </StackPanel>

              <StackPanel>
                <TextBlock Classes="fieldLabel" Margin="0,0,0,6" Text="{Translate {x:Static loc:LanguageManager+Keys.S111}}" />
                <Grid ColumnDefinitions="*,Auto">
                  <u:TagInput
                      AllowDuplicates="False"
                      PlaceholderText="{Translate {x:Static loc:LanguageManager+Keys.S110}}"
                      Separator=","
                      Tags="{Binding UnCopyFiles}" />
                  <Button
                      Grid.Column="1"
                      Click="OnPickUnCopyFile"
                      Height="32"
                      Margin="8,0,0,0"
                      Padding="0"
                      ToolTip.Tip="{Translate {x:Static loc:LanguageManager+Keys.S108}}"
                      Width="32">
                    <materialIcons:MaterialIcon Height="14" Kind="Plus" Width="14" />
                  </Button>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <ProgressBar
        Grid.Row="2"
        Height="2"
        IsIndeterminate="True"
        IsVisible="{Binding IsBusy}"
        Margin="0,8,0,0" />

    <!--  Footer  -->
    <Grid ColumnDefinitions="*,Auto" Grid.Row="3" Margin="0,16,0,0">
      <TextBlock
          FontSize="11"
          Foreground="{DynamicResource SemiColorWarning}"
          IsVisible="{Binding HasValidationMessage}"
          Text="{Binding ValidationMessage}"
          TextWrapping="Wrap"
          VerticalAlignment="Center" />
      <StackPanel
          Grid.Column="1"
          HorizontalAlignment="Right"
          Orientation="Horizontal"
          Spacing="8">
        <Button Command="{Binding CancelCommand}" Content="{Translate {x:Static loc:LanguageManager+Keys.S058}}" Height="32" Padding="16,0" />
        <Button
            Command="{Binding PreviousStepCommand}"
            Content="{Translate {x:Static loc:LanguageManager+Keys.S112}}"
            Height="32"
            IsVisible="{Binding IsLocalStep}"
            Padding="16,0" />
        <Button
            Classes="Primary"
            Command="{Binding NextStepCommand}"
            Content="{Translate {x:Static loc:LanguageManager+Keys.S113}}"
            Height="32"
            IsVisible="{Binding IsServerStep}"
            Padding="20,0" />
        <Button
            Classes="Primary"
            Command="{Binding ConfirmCommand}"
            Content="{Translate {x:Static loc:LanguageManager+Keys.S114}}"
            Height="32"
            IsVisible="{Binding IsLocalStep}"
            Padding="20,0" />
      </StackPanel>
    </Grid>
  </Grid>

  <Window.Styles>
    <Style Selector="Border.step">
      <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Width" Value="24" />
    </Style>
    <Style Selector="Border.step TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.step.active">
      <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
    </Style>
    <Style Selector="Border.step.active TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>
</Window>