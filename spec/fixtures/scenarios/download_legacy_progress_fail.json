    "check_update": {
      "lines": [
        {
          "isSuccess": true,
          "errorMsg": "",
          "data": {
            "has_update": true,
            "need_download_update": true,
            "current_version": "1.0.0",
            "new_version": "1.0.1"
          }
        }
      ],
      "line_delay_ms": 5
    },
    "download_update": {
      "lines": [
        {"isSuccess": true, "errorMsg": "", "data": {"index": 0, "total": 2, "file": "", "status": "BEGIN", "file_size": 0, "total_bytes": 2000}},
        {"isSuccess": true, "errorMsg": "", "data": {"index": 1, "total": 2, "file": "a.dll", "status": "START", "file_size": 1000, "downloaded_bytes": 0, "total_bytes": 2000, "speed_bps": 0}},
        {"isSuccess": false, "errorMsg": "a.dll: checksum mismatch", "data": {"index": 1, "total": 2, "file": "a.dll", "status": "FAIL", "file_size": 1000, "downloaded_bytes": 0, "total_bytes": 2000, "speed_bps": 0, "error": "checksum mismatch"}},
        {"isSuccess": true, "errorMsg": "", "data": {"index": 1, "total": 2, "file": "a.dll", "status": "DONE", "file_size": 1000, "downloaded_bytes": 1000, "total_bytes": 2000, "speed_bps": 0}},
        {"isSuccess": true, "errorMsg": "", "data": {"index": 2, "total": 2, "file": "b.dll", "status": "DONE", "file_size": 1000, "downloaded_bytes": 2000, "total_bytes": 2000, "speed_bps": 0}},
        {"isSuccess": false, "errorMsg": "下载完成但有 1 个文件失败: a.dll", "data": {"version": "1.0.1", "failed_files": ["a.dll"], "reason": "partial_failure"}}
      ],
      "line_delay_ms": 5
    }
  }
