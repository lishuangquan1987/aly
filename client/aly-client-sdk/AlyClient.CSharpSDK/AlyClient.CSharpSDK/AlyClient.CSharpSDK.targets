<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    AlyClient.CSharpSDK: deploy runtime files to ../UpdateFolder/

    aly-client.exe 和 aly-client-ui.exe 都在首次构建时从 GitHub Releases 下载。
    client.json 不存在时用默认模板生成。

    aly-client-ui.exe 是可选的图形前端；设置 AlyIncludeClientUi=false 可跳过，
    下载失败也只警告（不会让已有项目的构建失败）。
  -->

  <PropertyGroup>
    <AlyUpdateFolder Condition="'$(AlyUpdateFolder)' == ''">$(OutDir)..\UpdateFolder\</AlyUpdateFolder>
    <AlyClientVersion Condition="'$(AlyClientVersion)' == ''">ALY_CLIENT_VERSION_PLACEHOLDER</AlyClientVersion>
    <AlyClientDownloadUrl Condition="'$(AlyClientDownloadUrl)' == ''">https://github.com/lishuangquan1987/aly/releases/download/v$(AlyClientVersion)/aly-client.exe</AlyClientDownloadUrl>
    <AlyClientUiDownloadUrl Condition="'$(AlyClientUiDownloadUrl)' == ''">https://github.com/lishuangquan1987/aly/releases/download/v$(AlyClientVersion)/aly-client-ui.exe</AlyClientUiDownloadUrl>
    <AlyIncludeClientUi Condition="'$(AlyIncludeClientUi)' == ''">true</AlyIncludeClientUi>
  </PropertyGroup>

  <Target Name="AlyDeployToUpdateFolder" BeforeTargets="Build">

    <MakeDir Directories="$(AlyUpdateFolder)" />

    <!-- Download aly-client.exe from GitHub Releases if not present.
         下载失败只警告：更新器是运行时可选组件，不能因为它（网络/仓库不可达）阻断宿主构建。 -->
    <Exec Condition="!Exists('$(AlyUpdateFolder)aly-client.exe')"
          ContinueOnError="WarnAndContinue"
          Command="powershell -NoProfile -Command &quot;
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12;
try {
  Invoke-WebRequest -Uri '$(AlyClientDownloadUrl)' -OutFile '$(AlyUpdateFolder)aly-client.exe' -ErrorAction Stop;
  Write-Host 'Downloaded aly-client.exe v$(AlyClientVersion) successfully';
} catch {
  Write-Error &quot;Failed to download aly-client.exe: $($_.Exception.Message)&quot;;
  exit 1;
}&quot;" />

    <!-- Generate default client.json if missing -->
    <WriteLinesToFile Condition="!Exists('$(AlyUpdateFolder)client.json')"
                      File="$(AlyUpdateFolder)client.json"
                      Lines="{&quot;main_exe_relative_path&quot;: &quot;../ApplicationFolder/YourApp.exe&quot;,&quot;must_close_process_name&quot;: [&quot;YourApp&quot;]}"
                      Overwrite="true" />

    <!-- Download aly-client-ui.exe (optional GUI front-end) from GitHub Releases if not present.
         失败只警告：UI 是可选组件，不能因为它缺失就中断宿主项目的构建。 -->
    <Exec Condition="'$(AlyIncludeClientUi)' == 'true' AND !Exists('$(AlyUpdateFolder)aly-client-ui.exe')"
          ContinueOnError="true"
          Command="powershell -NoProfile -Command &quot;
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12;
try {
  Invoke-WebRequest -Uri '$(AlyClientUiDownloadUrl)' -OutFile '$(AlyUpdateFolder)aly-client-ui.exe' -ErrorAction Stop;
  Write-Host 'Downloaded aly-client-ui.exe v$(AlyClientVersion) successfully';
} catch {
  Write-Warning &quot;aly-client-ui.exe not downloaded (optional GUI front-end): $($_.Exception.Message)&quot;;
}&quot;" />

  </Target>

</Project>
