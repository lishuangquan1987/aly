<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    AlyClient.CSharpSDK: 准备 ../UpdateFolder/

    更新器与图形前端不再由 SDK 下载或复制：
      - 正式渠道是 AlyPublish 安装包（包内 client/<rid>/aly-client(.exe)）：
        GUI 在“初始化项目 / 项目设置”时按本包平台把它复制进项目同级的 UpdateFolder/；
      - 手工放置同样可用：把 aly-client.exe 与 aly-client-ui.exe 放进 ../UpdateFolder/。

    本 targets 只做两件事：建 UpdateFolder/ 目录、在缺失时生成默认 client.json，
    这样没有 GUI 的宿主仍能用。

    平台判断使用 $(OS)（Windows 上为 Windows_NT）：这是所有 MSBuild 版本
    （含 VS2013/2015 的 net40 构建）都支持的写法，不依赖属性函数。
  -->

  <PropertyGroup>
    <AlyUpdateFolder Condition="'$(AlyUpdateFolder)' == '' AND '$(OS)' == 'Windows_NT'">$(OutDir)..\UpdateFolder\</AlyUpdateFolder>
    <AlyUpdateFolder Condition="'$(AlyUpdateFolder)' == '' AND '$(OS)' != 'Windows_NT'">$(OutDir)../UpdateFolder/</AlyUpdateFolder>
  </PropertyGroup>

  <Target Name="AlyDeployToUpdateFolder" BeforeTargets="Build">

    <MakeDir Directories="$(AlyUpdateFolder)" />

    <!-- Generate default client.json if missing -->
    <WriteLinesToFile Condition="!Exists('$(AlyUpdateFolder)client.json')"
                      File="$(AlyUpdateFolder)client.json"
                      Lines="{&quot;main_exe_relative_path&quot;: &quot;../ApplicationFolder/YourApp.exe&quot;,&quot;must_close_process_name&quot;: [&quot;YourApp&quot;]}"
                      Overwrite="true" />

  </Target>

</Project>
